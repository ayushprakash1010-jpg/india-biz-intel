# ── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
APP_VERSION=1.0.0

# ── Database (Neon / Railway Postgres) ───────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/india_biz_intel?sslmode=require"

# ── Redis (Upstash) ───────────────────────────────────────────────────────────
REDIS_URL="rediss://default:PASSWORD@HOST:6380"
REDIS_WARN_THRESHOLD=8000

# ── Vector DB (Qdrant Cloud) ──────────────────────────────────────────────────
QDRANT_URL="https://YOUR-CLUSTER-ID.us-east4-0.gcp.cloud.qdrant.io"
QDRANT_API_KEY=""

# ── LLM (Google Gemini) ───────────────────────────────────────────────────────
GEMINI_API_KEY=""
GEMINI_RPM_LIMIT=14

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=""                        # openssl rand -base64 64
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=""                # openssl rand -base64 64 (DIFFERENT from JWT_SECRET)
JWT_REFRESH_EXPIRES_IN=7d
NEXTAUTH_SECRET=""                   # openssl rand -base64 32
NEXTAUTH_URL="https://india-biz-intel.vercel.app"

# ── CORS ──────────────────────────────────────────────────────────────────────
FRONTEND_URL="https://india-biz-intel.vercel.app"

# ── BullMQ Board ──────────────────────────────────────────────────────────────
BULL_BOARD_USERNAME="admin"
BULL_BOARD_PASSWORD=""               # Set a strong password

# ── Monitoring (optional) ─────────────────────────────────────────────────────
SENTRY_DSN=""
BETTERSTACK_SOURCE_TOKEN=""

# ── Frontend (Next.js) ───────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL="https://your-api.railway.app/api/v1"

# ── Auth.js ──────────────────────────────────────────────────────────────────
AUTH_SECRET=""                       # openssl rand -base64 32
AUTH_URL="https://india-biz-intel.vercel.app"

# ── LinkedIn ──────────────────────────────────────────────────────────────────
AUTH_LINKEDIN_ID=""
AUTH_LINKEDIN_SECRET=""
LINKEDIN_ORGANIZATION_ID=""
